<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yorkseed House — The Pop Up Series</title>
<meta name="description" content="Yorkseed House is a curated pop-up series connecting global founders, investors, and ecosystem leaders at the world's most important tech events.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,600&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --cream:#F4EFE4;
  --cream-dark:#EAE3D2;
  --green:#1C3A2A;
  --green-mid:#274D38;
  --gold:#B8936A;
  --gold-light:#D4AA85;
  --black:#0C0C0C;
  --white:#FAFAF6;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--black);overflow-x:hidden;}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;justify-content:space-between;align-items:center;
  padding:24px 56px;transition:all 0.4s;
}
nav.scrolled{
  background:rgba(244,239,228,0.96);backdrop-filter:blur(10px);
  padding:14px 56px;border-bottom:1px solid rgba(14,14,14,0.08);
}
.nav-logo{
  font-size:0.73rem;font-weight:700;letter-spacing:0.22em;
  text-transform:uppercase;color:var(--white);text-decoration:none;transition:color 0.4s;
}
nav.scrolled .nav-logo{color:var(--black);}
.nav-links{display:flex;gap:28px;align-items:center;}
.nav-links a{
  font-size:0.73rem;font-weight:500;letter-spacing:0.07em;text-transform:uppercase;
  color:rgba(255,255,255,0.7);text-decoration:none;transition:all 0.3s;cursor:pointer;
}
nav.scrolled .nav-links a{color:rgba(14,14,14,0.52);}
.nav-links a:hover{color:var(--white)!important;}
nav.scrolled .nav-links a:hover{color:var(--black)!important;}
.nav-cta{
  background:var(--white)!important;color:var(--black)!important;
  padding:10px 24px;font-weight:700!important;letter-spacing:0.1em!important;
  transition:all 0.2s!important;
}
nav.scrolled .nav-cta{background:var(--green)!important;color:var(--white)!important;}
.nav-cta:hover{background:var(--gold)!important;color:var(--white)!important;}
.nav-live{color:var(--gold)!important;font-weight:700!important;}
nav.scrolled .nav-live{color:var(--gold)!important;}

/* ── HERO ── */
.hero{
  height:100vh;min-height:700px;
  position:relative;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
}
.hero-bg{
  position:absolute;inset:0;
  background:var(--green);
}
/* Subtle grain texture */
.hero-bg::after{
  content:'';position:absolute;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
  opacity:0.35;
}
/* Decorative horizontal rule lines */

/* Large decorative "H" background letter */
.hero-deco{
  position:absolute;
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(40vw,60vw,900px);
  font-weight:300;
  color:rgba(255,255,255,0.025);
  line-height:1;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  pointer-events:none;
  user-select:none;
  letter-spacing:-0.05em;
}

.hero-inner{
  position:relative;z-index:2;
  text-align:center;
  padding:0 24px;
  max-width:900px;
}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:16px;
  font-size:0.65rem;font-weight:700;letter-spacing:0.3em;text-transform:uppercase;
  color:var(--gold);margin-bottom:32px;
  animation:fadeUp 0.7s ease both;
}
.hero-eyebrow::before,.hero-eyebrow::after{content:'';width:36px;height:1px;background:var(--gold);}
.hero-title{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(5rem,9vw,10rem);
  font-weight:300;line-height:0.88;
  color:var(--white);
  margin-bottom:28px;
  animation:fadeUp 0.8s 0.1s ease both;
  letter-spacing:-0.01em;
}
.hero-title em{font-style:italic;color:var(--gold-light);}
.hero-tagline{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(1.1rem,1.8vw,1.5rem);
  font-style:italic;font-weight:300;
  color:rgba(255,255,255,0.5);
  margin-bottom:44px;
  animation:fadeUp 0.8s 0.18s ease both;
  max-width:560px;margin-left:auto;margin-right:auto;
  line-height:1.5;
}
.hero-btns{
  display:flex;gap:12px;justify-content:center;flex-wrap:wrap;
  animation:fadeUp 0.8s 0.26s ease both;
  margin-bottom:44px;
}
.hero-stats{
  display:flex;gap:56px;justify-content:center;flex-wrap:wrap;
  animation:fadeUp 0.8s 0.34s ease both;
  padding-top:36px;
  border-top:1px solid rgba(255,255,255,0.08);
}
.hs{display:flex;flex-direction:column;gap:4px;align-items:center;}
.hs-num{
  font-family:'Cormorant Garamond',serif;
  font-size:2.8rem;font-weight:300;color:var(--white);line-height:1;
}
.hs-lbl{font-size:0.6rem;letter-spacing:0.24em;text-transform:uppercase;color:rgba(255,255,255,0.35);font-weight:700;}

/* Scroll indicator */
.scroll-hint{
  position:absolute;bottom:36px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;
  animation:fadeUp 1s 0.6s ease both;
  z-index:2;
}
.scroll-hint span{font-size:0.58rem;letter-spacing:0.22em;text-transform:uppercase;color:rgba(255,255,255,0.25);font-weight:700;}
.scroll-dot{
  width:1px;height:40px;background:linear-gradient(to bottom,rgba(255,255,255,0.3),transparent);
  animation:scrollPulse 2s ease infinite;
}

/* ── BUTTONS ── */
.btn{
  display:inline-block;padding:14px 34px;
  font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;
  text-decoration:none;cursor:pointer;border:none;transition:all 0.2s;
}
.btn-light{background:var(--white);color:var(--black);}
.btn-light:hover{background:var(--gold);color:var(--white);}
.btn-outline-light{
  background:transparent;color:var(--white);
  border:1.5px solid rgba(255,255,255,0.35);
}
.btn-outline-light:hover{background:var(--white);color:var(--black);}
.btn-dark{background:var(--green);color:var(--white);}
.btn-dark:hover{background:var(--gold);color:var(--white);}
.btn-gold{background:var(--gold);color:var(--white);}
.btn-gold:hover{background:var(--green);color:var(--white);}

/* ── SECTION SHARED ── */
section{padding:100px 56px;}
.section-eyebrow{
  display:inline-flex;align-items:center;gap:12px;
  font-size:0.62rem;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;
  color:var(--gold);margin-bottom:16px;
}
.section-eyebrow::before{content:'';width:24px;height:1px;background:var(--gold);}
.section-title{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(2.8rem,5vw,5.5rem);
  font-weight:300;line-height:1;
  color:var(--black);
  letter-spacing:-0.01em;
}
.section-title em{font-style:italic;color:var(--green);}
.section-sub{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(1rem,1.4vw,1.25rem);
  font-style:italic;font-weight:300;
  color:rgba(12,12,12,0.5);line-height:1.6;
  margin-top:12px;
}

/* ── INTRO ── */
.intro{
  background:var(--cream);
  padding:100px 56px;
}
.intro-inner{
  max-width:1200px;margin:0 auto;
  display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;
}
.intro-left{}
.intro-right{}
.intro-body{
  font-size:1.05rem;line-height:1.75;color:rgba(12,12,12,0.72);
  margin-top:28px;
}
.intro-body p+p{margin-top:16px;}
.intro-rule{
  width:48px;height:2px;background:var(--gold);
  margin:32px 0;
}
.intro-pillars{
  display:flex;flex-direction:column;gap:0;
  border:1px solid var(--cream-dark);
}
.pillar{
  padding:24px 28px;
  border-bottom:1px solid var(--cream-dark);
  transition:background 0.2s;
}
.pillar:last-child{border-bottom:none;}
.pillar:hover{background:var(--cream-dark);}
.pillar-num{
  font-family:'Cormorant Garamond',serif;
  font-size:2.2rem;font-weight:300;color:var(--gold);
  line-height:1;margin-bottom:8px;
}
.pillar-name{
  font-size:0.72rem;font-weight:700;letter-spacing:0.14em;
  text-transform:uppercase;color:var(--black);margin-bottom:6px;
}
.pillar-desc{font-size:0.85rem;color:rgba(12,12,12,0.55);line-height:1.5;}

/* ── HOUSES GRID ── */
.houses{
  background:var(--green);
  padding:100px 56px;
}
.houses-header{
  max-width:1200px;margin:0 auto 60px;
  display:flex;justify-content:space-between;align-items:flex-end;
}
.houses-header .section-title{color:var(--white);}
.houses-header .section-eyebrow{color:var(--gold);}
.houses-header .section-sub{color:rgba(255,255,255,0.45);}
.houses-grid{
  max-width:1200px;margin:0 auto;
  display:grid;grid-template-columns:repeat(3,1fr);gap:2px;
}

/* ── HOUSE CARD ── */
.house-card{
  position:relative;overflow:hidden;
  aspect-ratio:3/4;
  display:flex;flex-direction:column;justify-content:flex-end;
  cursor:pointer;
  text-decoration:none;
}
.house-card-bg{
  position:absolute;inset:0;
  transition:transform 0.6s ease;
}
.house-card:hover .house-card-bg{transform:scale(1.04);}
.house-card-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(0,0,0,0.82) 0%,rgba(0,0,0,0.2) 55%,transparent 100%);
  transition:opacity 0.3s;
}
.house-card:hover .house-card-overlay{opacity:0.9;}
.house-card-body{
  position:relative;z-index:2;
  padding:32px 28px;
}
.hc-status{
  display:inline-block;
  font-size:0.58rem;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;
  padding:5px 12px;margin-bottom:16px;
}
.hc-status.live{background:var(--gold);color:var(--white);}
.hc-status.soon{background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.7);border:1px solid rgba(255,255,255,0.2);}
.hc-status.future{background:transparent;color:rgba(255,255,255,0.35);border:1px solid rgba(255,255,255,0.12);}
.hc-event{
  font-size:0.62rem;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;
  color:var(--gold);margin-bottom:8px;
}
.hc-title{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(2rem,2.8vw,2.8rem);
  font-weight:300;line-height:1.0;
  color:var(--white);margin-bottom:10px;
  letter-spacing:-0.01em;
}
.hc-title em{font-style:italic;}
.hc-meta{
  font-size:0.78rem;font-weight:400;
  color:rgba(255,255,255,0.5);margin-bottom:20px;
  line-height:1.5;
}
.hc-cta{
  display:inline-flex;align-items:center;gap:8px;
  font-size:0.65rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;
  color:var(--white);text-decoration:none;
  transition:gap 0.2s;
}
.house-card:hover .hc-cta{gap:14px;}
.hc-cta::after{content:'→';font-size:0.9rem;font-weight:300;}

/* Card specific backgrounds — city photos */
.card-nytw .house-card-bg{background:url('https://images.pexels.com/photos/24460835/pexels-photo-24460835.jpeg?w=900&q=80') center center/cover no-repeat;}
.card-nytw .house-card-bg::before,.card-nytw .house-card-bg::after{content:none;}
.card-sxsw .house-card-bg{background:url('https://images.pexels.com/photos/37197042/pexels-photo-37197042.jpeg?w=900&q=80') center center/cover no-repeat;}
.card-sxsw .house-card-bg::before,.card-sxsw .house-card-bg::after{content:none;}
.card-future .house-card-bg{background:url('https://images.pexels.com/photos/7049506/pexels-photo-7049506.jpeg?w=900&q=80') center center/cover no-repeat;}
.card-future .house-card-bg::before,.card-future .house-card-bg::after{content:none;}

/* ── PARTNER / CTA SECTION ── */
.partner{
  background:var(--cream-dark);
  padding:100px 56px;
}
.partner-inner{
  max-width:1200px;margin:0 auto;
  display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;
}
.partner-left{}
.partner-right{
  display:flex;flex-direction:column;gap:0;
}
.partner-option{
  padding:28px 0;
  border-bottom:1px solid rgba(12,12,12,0.1);
  display:flex;justify-content:space-between;align-items:center;
  gap:20px;
  transition:padding-left 0.25s;
  cursor:default;
}
.partner-option:first-child{border-top:1px solid rgba(12,12,12,0.1);}
.partner-option:hover{padding-left:8px;}
.po-left{}
.po-name{
  font-size:0.72rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;
  color:var(--black);margin-bottom:4px;
}
.po-desc{font-size:0.85rem;color:rgba(12,12,12,0.5);line-height:1.4;}
.po-arrow{
  font-size:1.4rem;color:var(--gold);flex-shrink:0;
  transition:transform 0.2s;font-weight:300;
}
.partner-option:hover .po-arrow{transform:translateX(5px);}
.partner-body{
  font-size:1.05rem;line-height:1.75;color:rgba(12,12,12,0.65);
  margin-top:24px;margin-bottom:36px;
}

/* ── ABOUT STRIP ── */
.about{
  background:var(--black);
  padding:80px 56px;
}
.about-inner{
  max-width:1200px;margin:0 auto;
  display:flex;justify-content:space-between;align-items:center;gap:40px;
  flex-wrap:wrap;
}
.about-text{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(1.5rem,2.5vw,2.2rem);
  font-weight:300;line-height:1.4;
  color:rgba(255,255,255,0.6);
  max-width:640px;
}
.about-text strong{color:var(--white);font-weight:400;}
.about-text em{color:var(--gold-light);font-style:italic;}

/* ── FOOTER ── */
footer{background:var(--green);padding:56px 56px 32px;}
.ft{
  max-width:1200px;margin:0 auto;
  display:grid;grid-template-columns:1fr 1fr 1fr 1fr;
  gap:40px;padding-bottom:40px;
  border-bottom:1px solid rgba(255,255,255,0.08);
  align-items:start;
}
.ft-brand{}
.ft-logo{margin-bottom:14px;}
.ft-tagline{
  font-size:0.78rem;color:rgba(255,255,255,0.38);
  line-height:1.65;
}
.ft-tagline strong{
  display:block;
  font-family:'Cormorant Garamond',serif;
  font-size:1rem;font-weight:300;font-style:italic;
  color:rgba(255,255,255,0.5);margin-bottom:6px;
}
.fc{}
.fc h5{
  font-size:0.58rem;font-weight:700;letter-spacing:0.28em;
  text-transform:uppercase;color:rgba(255,255,255,0.25);
  margin-bottom:16px;
}
.fc a{
  display:block;font-size:0.8rem;
  color:rgba(255,255,255,0.55);text-decoration:none;
  margin-bottom:10px;transition:color 0.2s;
}
.fc a:hover{color:var(--gold);}
.fc a.fc-live{color:var(--gold-light);}
.ft-bottom{
  max-width:1200px;margin:24px auto 0;
  display:flex;justify-content:space-between;align-items:center;
  flex-wrap:wrap;gap:10px;
}
.ft-copy{font-size:0.65rem;color:rgba(255,255,255,0.2);letter-spacing:0.04em;}
.ft-tagstrip{
  display:flex;gap:16px;
  font-size:0.6rem;font-weight:700;letter-spacing:0.16em;
  text-transform:uppercase;color:rgba(255,255,255,0.15);
}

/* ── KEYFRAMES ── */
@keyframes fadeUp{
  from{opacity:0;transform:translateY(24px);}
  to{opacity:1;transform:translateY(0);}
}
@keyframes scrollPulse{
  0%,100%{opacity:0.3;transform:scaleY(1);}
  50%{opacity:1;transform:scaleY(1.15);}
}

/* ── RESPONSIVE ── */
/* ── HAMBURGER MENU ── */
.hamburger{
  display:none;flex-direction:column;justify-content:center;gap:5px;
  background:none;border:none;cursor:pointer;padding:8px;z-index:200;
}
.hamburger span{
  display:block;width:24px;height:2px;
  background:var(--white);border-radius:2px;transition:all 0.3s;
}
nav.scrolled .hamburger span{background:var(--black);}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.hamburger.open span:nth-child(2){opacity:0;}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

.mobile-menu{
  display:none;position:fixed;inset:0;z-index:150;
  background:var(--green);flex-direction:column;
  justify-content:center;align-items:center;gap:32px;
}
.mobile-menu.open{display:flex;}
.mobile-menu a{
  font-size:1.6rem;font-family:'Cormorant Garamond',serif;font-weight:300;
  color:var(--white);text-decoration:none;letter-spacing:0.06em;
  transition:color 0.2s;
}
.mobile-menu a:hover{color:var(--gold);}
.mobile-menu .mm-cta{
  margin-top:16px;font-family:'DM Sans',sans-serif;
  font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;
  background:var(--gold);color:var(--white);padding:14px 36px;
}

/* ── TABLET: 768–1024px ── */
@media(max-width:1024px){
  nav{padding:20px 32px;}
  nav.scrolled{padding:14px 32px;}
  section,footer,.intro,.houses,.partner,.about{padding-left:32px;padding-right:32px;}
  .intro-inner,.partner-inner{grid-template-columns:1fr;gap:40px;}
  .intro-right{order:-1;}
  .houses-grid{grid-template-columns:1fr 1fr;}
  .house-card{aspect-ratio:3/4;}
  .houses-header{flex-direction:column;align-items:flex-start;gap:12px;}
  .ft{grid-template-columns:1fr 1fr;gap:36px;}
  .ft-tagline{max-width:100%;}
  .hero-stats{gap:36px;}
  .about-inner{flex-direction:column;gap:28px;text-align:center;}
}

/* ── MOBILE: ≤767px ── */
@media(max-width:767px){
  /* Nav */
  nav{padding:16px 20px;}
  nav.scrolled{padding:12px 20px;}
  .nav-links{display:none;}
  .hamburger{display:flex;}
  #logo-white,#logo-dark{height:64px !important;}

  /* Sections */
  section,.intro,.houses,.partner,.about{padding:64px 20px;}
  footer{padding:48px 20px 28px;}

  /* Hero */
  .hero{min-height:100svh;align-items:flex-end;}
  .hero-inner{text-align:left;padding:0 0 60px;}
  .hero-btns{flex-direction:column;align-items:flex-start;gap:10px;}
  .hero-btns .btn{width:100%;text-align:center;}
  .hero-stats{gap:20px;justify-content:flex-start;border-top:1px solid rgba(255,255,255,0.08);padding-top:24px;}
  .hs-num{font-size:2rem;}

  /* Intro pillars */
  .intro-inner{grid-template-columns:1fr;gap:36px;}
  .pillar{padding:18px 20px;}

  /* Houses */
  .houses-grid{grid-template-columns:1fr;gap:3px;}
  .house-card{aspect-ratio:4/3;}
  .houses-header{flex-direction:column;align-items:flex-start;gap:10px;}
  .hc-title{font-size:2rem;}

  /* Partner */
  .partner-inner{grid-template-columns:1fr;gap:36px;}
  .partner-option{padding:20px 0;}
  .btn{width:100%;text-align:center;display:block;}

  /* About */
  .about-inner{flex-direction:column;gap:24px;}
  .about-text{font-size:1.3rem;}

  /* Footer */
  .ft{grid-template-columns:1fr;gap:28px;}
  .ft>div:first-child{order:0;}
  .fb2{flex-direction:column;gap:6px;font-size:0.65rem;}

  /* Section typography */
  .section-title{font-size:clamp(2.2rem,8vw,3.5rem);}
  .section-sub{font-size:1rem;}
  .partner-body{font-size:0.95rem;}
  .intro-body{font-size:0.95rem;}
}
</style>
</head>
<body>

<!-- NAV -->
<nav id="mainNav">
  <a href="/" class="nav-logo" style="display:flex;align-items:center;position:relative;"><img id="logo-white" src="data:image/png;base64," alt="Yorkseed House" style="height:100px;width:auto;transition:opacity 0.4s;"/><img id="logo-dark" src="data:image/png;base64," alt="Yorkseed House" style="height:100px;width:auto;transition:opacity 0.4s;position:absolute;opacity:0;"/></a>
  <div class="nav-links">
    <a href="/nytw2026" class="hide-mobile nav-live">NY Tech Week ↗</a>
