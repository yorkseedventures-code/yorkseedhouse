<script>
window.addEventListener('scroll', function(){
  var scrolled = window.scrollY > 60;
  document.getElementById('mainNav').classList.toggle('scrolled', scrolled);
  var wl = document.getElementById('logo-white');
  var dl = document.getElementById('logo-dark');
  if(wl && dl){
    wl.style.opacity = scrolled ? '0' : '1';
    dl.style.opacity = scrolled ? '1' : '0';
  }
});
var hamburger = document.getElementById('hamburger');
var mobileMenu = document.getElementById('mobileMenu');
hamburger.addEventListener('click', function(){
  var open = mobileMenu.classList.toggle('open');
  hamburger.classList.toggle('open', open);
  document.body.style.overflow = open ? 'hidden' : '';
});
function closeMobileMenu(){
  mobileMenu.classList.remove('open');
  hamburger.classList.remove('open');
  document.body.style.overflow = '';
}
</script>
